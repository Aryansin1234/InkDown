{
  "name": "inkdown-vscode",
  "displayName": "InkDown — Markdown to PDF, DOCX & HTML",
  "description": "Convert Markdown to production-quality PDF, DOCX, and HTML with Mermaid diagrams, math (KaTeX), syntax highlighting, live preview, and one-click export.",
  "version": "1.6.1",
  "publisher": "inkdown",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "author": {
    "name": "Aryan Singh",
    "url": "https://github.com/Aryansin1234"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aryansin1234/InkDown"
  },
  "homepage": "https://github.com/Aryansin1234/InkDown#readme",
  "bugs": {
    "url": "https://github.com/Aryansin1234/InkDown/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "docx",
    "word",
    "export",
    "converter",
    "mermaid",
    "katex",
    "math",
    "preview",
    "pandoc",
    "inkdown"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "inkdown.convertToPdf",
        "title": "InkDown: Convert to PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "inkdown.convertToDocx",
        "title": "InkDown: Convert to DOCX",
        "icon": "$(file-text)"
      },
      {
        "command": "inkdown.convertToHtml",
        "title": "InkDown: Export as HTML",
        "icon": "$(globe)"
      },
      {
        "command": "inkdown.convertWithOptions",
        "title": "InkDown: Convert with Options…"
      },
      {
        "command": "inkdown.openPreview",
        "title": "InkDown: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "inkdown.startServer",
        "title": "InkDown: Start Server"
      },
      {
        "command": "inkdown.stopServer",
        "title": "InkDown: Stop Server"
      },
      {
        "command": "inkdown.batchExportFolder",
        "title": "InkDown: Export all Markdown files in folder",
        "icon": "$(folder-active)"
      },
      {
        "command": "inkdown.toggleAutoExport",
        "title": "InkDown: Toggle Auto-Export on Save"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "inkdown.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "inkdown.convertToPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "inkdown.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "inkdown.convertToPdf",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "inkdown.convertToDocx",
          "when": "editorLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "inkdown.convertToHtml",
          "when": "editorLangId == markdown",
          "group": "navigation@4"
        },
        {
          "command": "inkdown.convertWithOptions",
          "when": "editorLangId == markdown",
          "group": "navigation@5"
        }
      ],
      "explorer/context": [
        {
          "command": "inkdown.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "inkdown.convertToPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "inkdown.convertToDocx",
          "when": "resourceLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "inkdown.convertToHtml",
          "when": "resourceLangId == markdown",
          "group": "navigation@4"
        },
        {
          "command": "inkdown.convertWithOptions",
          "when": "resourceLangId == markdown",
          "group": "navigation@5"
        },
        {
          "command": "inkdown.batchExportFolder",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/inkdown.code-snippets"
      }
    ],
    "keybindings": [
      {
        "command": "inkdown.convertToPdf",
        "key": "ctrl+shift+alt+p",
        "mac": "cmd+shift+alt+p",
        "when": "resourceLangId == markdown"
      },
      {
        "command": "inkdown.convertToDocx",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d",
        "when": "resourceLangId == markdown"
      },
      {
        "command": "inkdown.convertToHtml",
        "key": "ctrl+shift+alt+h",
        "mac": "cmd+shift+alt+h",
        "when": "resourceLangId == markdown"
      },
      {
        "command": "inkdown.openPreview",
        "key": "ctrl+shift+alt+v",
        "mac": "cmd+shift+alt+v",
        "when": "resourceLangId == markdown"
      }
    ],
    "configuration": {
      "title": "InkDown",
      "properties": {
        "inkdown.inkdownPath": {
          "type": "string",
          "default": "",
          "description": "Path to the InkDown installation directory. Leave blank to auto-detect from the workspace."
        },
        "inkdown.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL of the InkDown server. Used when the server is running."
        },
        "inkdown.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for authenticating with the InkDown server (optional)."
        },
        "inkdown.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Output directory for converted files. Leave blank to save next to the source file."
        },
        "inkdown.defaultFormat": {
          "type": "string",
          "default": "pdf",
          "enum": [
            "pdf",
            "docx",
            "html"
          ],
          "description": "Default output format."
        },
        "inkdown.openAfterConvert": {
          "type": "boolean",
          "default": true,
          "description": "Open the converted file after successful conversion."
        },
        "inkdown.autoExport": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-export to the last-used format whenever a Markdown file is saved."
        },
        "inkdown.autoExportFormat": {
          "type": "string",
          "default": "pdf",
          "enum": [
            "pdf",
            "docx",
            "html"
          ],
          "description": "Format to use for auto-export on save."
        },
        "inkdown.defaultToc": {
          "type": "boolean",
          "default": false,
          "description": "Include a Table of Contents by default."
        },
        "inkdown.defaultAutoBreak": {
          "type": "boolean",
          "default": false,
          "description": "Insert page breaks before H1 headings by default."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle-inkdown && npm run compile",
    "bundle-inkdown": "node scripts/bundle-inkdown.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "sync-installed": "npm run bundle-inkdown && for d in \"$HOME\"/.vscode/extensions/inkdown.inkdown-vscode-* \"$HOME\"/.vscode-insiders/extensions/inkdown.inkdown-vscode-*; do [ -d \"$d\" ] && cp out/*.js out/*.js.map \"$d/out/\" && rm -rf \"$d/bundled\" && cp -R bundled \"$d/bundled\"; done; echo 'synced'",
    "package": "npm run bundle-inkdown && npx @vscode/vsce package --no-dependencies",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
